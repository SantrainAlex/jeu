# Copie ce fichier en .env.local et remplis au moins une des deux sources.

# RAWG : clé gratuite sur https://rawg.io/apidocs
RAWG_API_KEY=

# IGDB : crée une application sur https://dev.twitch.tv/console
# (catégorie « Website Integration », URL de redirection http://localhost)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Comptes (connexion par e-mail) : projet Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Facultatif — « Où l'acheter » sur la fiche d'un jeu
# Prix des boutiques PC : clé gratuite sur https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
# Codes d'affiliation (laisse vide si tu n'en as pas : les liens marchent quand même, sans commission)
INSTANT_GAMING_IGR=
AMAZON_TAG=
